/**
 * The display shim for the Firefly Pixie.
 *
 * ---------------------------------------------------------------------------
 * What this is
 *
 * `src/ui.c` is 5,989 lines written for a 128x64 monochrome panel, and it never
 * learned anything else about the display: it reaches it through six functions,
 * 298 of its 332 calls being `oled_draw_string` and `oled_draw_string_centered`.
 * This file implements those six against Firefly's ST7789 driver, so ui.c
 * compiles unchanged on a 240x240 colour screen with every layout, every
 * refusal and every clip-at-the-edge intact.
 *
 * That is the whole porting strategy. Redesigning the screens for colour would
 * be weeks of work discarding layout decisions already tested on hardware; this
 * is a day, and the redesign can happen one screen at a time afterwards behind
 * the same six functions.
 *
 * ---------------------------------------------------------------------------
 * The geometry, which is the only interesting decision here
 *
 * 240 is not a multiple of 128, so there is no clean integer scale. The obvious
 * 2x overflows: 21 characters at 6 logical pixels each, doubled, is 252 px into
 * a 240 px panel — the last character and a half fall off, which on a wallet
 * means the right-hand button label disappearing.
 *
 * So the glyph is doubled (5x7 becomes 10x14) and the *advance* is 11 rather
 * than 12: ten pixels of glyph and one of gap. 21 x 11 = 231, which fits with
 * nine pixels to spare, and the character count matches the SSD1306 exactly.
 * Nothing that fits on the reference device fails to fit here.
 *
 * Rows are 16 px (14 of glyph, 2 of gap), so eight rows occupy 128 px of the
 * 240 available and the block is centred vertically. The remaining 56 px top and
 * bottom are deliberately empty: filling them would mean inventing content the
 * reference device does not show, and the two builds must agree about what is
 * on screen.
 *
 * ---------------------------------------------------------------------------
 * Why a 1-bit backing store
 *
 * Everything is composed into a 128x64 bitmap and expanded to RGB565 in the
 * render callback. Two reasons: the driver is a *pull* model that asks for one
 * fragment at a time, so the frame has to exist somewhere anyway; and a 1-bit
 * buffer is 1 KB against 115 KB for a full RGB565 frame, on a part with 400 KB
 * and no PSRAM.
 *
 * It also keeps the port honest. A monochrome backing store cannot accidentally
 * grow colour that the reference build has no way to show.
 */

#include "oled.h"

#include <string.h>

#include "esp_log.h"
#include "firefly-display.h"
#include "font5x7.h"

static const char *TAG = "oled-pixie";

/* --------------------------------------------------------------- geometry */

#define PANEL_W        240
#define PANEL_H        240

#define GLYPH_SCALE    2
#define ADVANCE_PX     11    /* 5*2 glyph + 1 gap; 21 * 11 = 231 <= 240 */
#define ROW_PX         16    /* 7*2 glyph + 2 gap */

#define ORIGIN_X       ((PANEL_W - OLED_CHARS_PER_LINE * ADVANCE_PX) / 2)
#define ORIGIN_Y       ((PANEL_H - OLED_PAGES * ROW_PX) / 2)

/* Foreground in RGB565. The same faintly-blue white the SSD1306 emits, so a
   screenshot of one board is recognisably the same device as the other. */
#define FG_565         0x8F7F
#define BG_565         0x0000

/* The frame, one bit per pixel, laid out as the SSD1306 lays out its pages:
   one byte per column per page, bit 0 the top row. Identical to the reference
   build's framebuffer, which is what lets both share `font_5x7` and the same
   drawing logic. */
static uint8_t framebuffer[OLED_WIDTH * OLED_PAGES];

static FfxDisplayContext display = NULL;
static uint8_t contrast = 0xCF;

/* ------------------------------------------------------------- primitives */

static inline void set_pixel(int x, int y, bool on)
{
    if (x < 0 || y < 0 || x >= OLED_WIDTH || y >= OLED_HEIGHT) { return; }
    uint32_t index = (y / 8) * OLED_WIDTH + x;
    uint8_t bit = 1 << (y % 8);
    if (on) { framebuffer[index] |= bit; }
    else    { framebuffer[index] &= (uint8_t)~bit; }
}

static inline bool get_pixel(int x, int y)
{
    if (x < 0 || y < 0 || x >= OLED_WIDTH || y >= OLED_HEIGHT) { return false; }
    return (framebuffer[(y / 8) * OLED_WIDTH + x] >> (y % 8)) & 1;
}

/* ---------------------------------------------------------- the fragment

   Called by the driver once per fragment, bottom of the pull model. Expands
   the 1-bit frame into RGB565 at GLYPH_SCALE, which is where the whole
   monochrome-to-colour conversion happens: one branch, one colour pair. */
static void render_fragment(uint8_t *buffer, uint32_t y0, void *context)
{
    uint16_t *px = (uint16_t *)buffer;
    const int w = FfxDisplayFragmentWidth;
    const int h = FfxDisplayFragmentHeight;

    for (int fy = 0; fy < h; fy++) {
        const int py = (int)y0 + fy;
        /* Map the physical row back to a logical one. Outside the centred
           block there is nothing to look up, so the row is background and the
           inner loop is skipped entirely. */
        const int ly = (py - ORIGIN_Y) / GLYPH_SCALE;
        const bool row_inside = (py >= ORIGIN_Y) && (ly < OLED_HEIGHT);

        for (int fx = 0; fx < w; fx++) {
            uint16_t colour = BG_565;
            if (row_inside) {
                const int lx = (fx - ORIGIN_X) / GLYPH_SCALE;
                if (fx >= ORIGIN_X && lx < OLED_WIDTH && get_pixel(lx, ly)) {
                    colour = FG_565;
                }
            }
            px[fy * w + fx] = colour;
        }
    }
}

/* ------------------------------------------------------------------- API
   The six functions ui.c uses, and nothing else. Every one of them has the
   same signature and the same meaning as in src/oled.c; a difference here
   would be a difference between the two boards, which is the one thing this
   file exists to avoid. */

esp_err_t oled_init(void)
{
    memset(framebuffer, 0, sizeof(framebuffer));

    /* Pin map: firefly-hollows/src/config.h, BOARD_REV 5. CS is tied to
       ground on rev.3 and later, so the bus variant without it is correct. */
    display = ffx_display_init(FfxDisplaySpiBus2, PIXIE_PIN_DISPLAY_DC,
                               PIXIE_PIN_DISPLAY_RESET,
                               FfxDisplayRotationRibbonRight,
                               render_fragment, NULL);
    if (display == NULL) {
        /* The driver allocates DMA-capable RAM and returns NULL when it
           cannot. Said out loud rather than swallowed: a wallet with no screen
           must not reach the PIN prompt. */
        ESP_LOGE(TAG, "display init failed (DMA allocation)");
        return ESP_ERR_NO_MEM;
    }

    ESP_LOGI(TAG, "ST7789 240x240, %dx scale, %d cols x %d rows",
             GLYPH_SCALE, OLED_CHARS_PER_LINE, OLED_PAGES);
    return ESP_OK;
}

esp_err_t oled_clear(void)
{
    memset(framebuffer, 0, sizeof(framebuffer));
    return ESP_OK;
}

esp_err_t oled_draw_char_at(uint8_t page, uint8_t col, char c)
{
    if (c < 32 || c > 126) { c = ' '; }
    const uint8_t *glyph = font_5x7_glyph(c);
    for (int gx = 0; gx < 5; gx++) {
        for (int gy = 0; gy < 7; gy++) {
            if (glyph[gx] & (1 << gy)) {
                set_pixel(col + gx, page * 8 + gy, true);
            }
        }
    }
    return ESP_OK;
}

esp_err_t oled_draw_string(uint8_t page, uint8_t col, const char *str)
{
    /* Clipped at the right edge, never wrapped, exactly as src/oled.c does:
         if (cursor_col >= OLED_WIDTH) break;
       A line that runs off the reference panel runs off this one too. */
    uint8_t x = col;
    while (*str) {
        if (x >= OLED_WIDTH) { break; }
        oled_draw_char_at(page, x, *str++);
        x += 6;
    }
    return ESP_OK;
}

esp_err_t oled_draw_string_centered(uint8_t page, const char *str)
{
    size_t len = strlen(str);
    if (len > OLED_CHARS_PER_LINE) { len = OLED_CHARS_PER_LINE; }
    return oled_draw_string(page, (uint8_t)((OLED_WIDTH - len * 6) / 2), str);
}

esp_err_t oled_set_pixel(uint8_t x, uint8_t y, bool on)
{
    set_pixel(x, y, on);
    return ESP_OK;
}

esp_err_t oled_fill_page(uint8_t page, uint8_t pattern)
{
    if (page >= OLED_PAGES) { return ESP_ERR_INVALID_ARG; }
    memset(&framebuffer[(size_t)page * OLED_WIDTH], pattern, OLED_WIDTH);
    return ESP_OK;
}

esp_err_t oled_set_contrast(uint8_t value)
{
    /* No contrast register on an ST7789. Kept so ui.c's brightness setting
       compiles and stores the user's choice; wiring it to the backlight is a
       later job and needs a pin the rev.5 map does not document. */
    contrast = value;
    return ESP_OK;
}

esp_err_t oled_flush(void)
{
    if (display == NULL) { return ESP_ERR_INVALID_STATE; }
    /* The driver is a pull model: it calls render_fragment() for each fragment
       and returns non-zero on the last one. Pushing the whole frame here keeps
       oled_flush() meaning what it means on the reference board — "the screen
       now shows what was drawn" — rather than leaking the fragment loop into
       ui.c. */
    while (ffx_display_renderFragment(display) == 0) { }
    return ESP_OK;
}
