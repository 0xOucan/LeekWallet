# Dependency hardening.
#
# pnpm helps with supply-chain risk but does not solve it. What it genuinely
# gives you is a strict node_modules layout (no phantom dependencies) and a
# lockfile with integrity hashes. What it does not give you is protection from
# a legitimate package publishing a malicious version — that arrives through
# the front door on your next install.

# The single biggest lever. Most npm supply-chain incidents execute through a
# postinstall script, and pnpm 9 still runs those by default; pnpm 10 changed
# the default, we are on 9.x. Nothing in this project needs them.
ignore-scripts=true

# Exact versions, so an install today and an install next month resolve
# identically without relying on a range being honoured.
save-exact=true

# Refuse to silently update the lockfile. A dependency change should be a
# deliberate commit someone reviews, not a side effect of running install.
prefer-frozen-lockfile=true
