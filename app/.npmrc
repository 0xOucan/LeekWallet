ignore-scripts=true
save-exact=true
prefer-frozen-lockfile=true
# Seven days, in minutes.
#
# The strongest single mitigation against the attack pnpm otherwise does not
# stop: a legitimate package publishing a malicious version. Those are usually
# spotted and yanked within hours, so refusing anything published in the last
# week means the ecosystem does the detection and this project never installs
# the bad version at all.
#
# REQUIRES pnpm 10.16 or newer. On pnpm 9 this key is silently ignored, so it
# is inert here until the toolchain moves - see app/README.md.
minimumReleaseAge=10080
